# --- CLM model server (on gx10) ---
# The gx10 CLM "System One" endpoint. Run an SSH tunnel to it:
#     ssh -L 8700:localhost:8700 user@gx10
# then point CLM_BASE_URL at the local end of that tunnel.
CLM_BASE_URL=http://127.0.0.1:8700

# Opcionális: ha a gx10-es CLM szerver API kulcsot kér.
# CLM_API_KEY=

# Opcionális modellnév (default: clm-latest).
# CLM_MODEL=clm-latest
